{
  "version": 2,
  "public": false,
  "headers": [
    {
      "source": "/(companion/)?sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(companion/)?(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/feed.ics", "destination": "/api/feed" },
    { "source": "/cal.ics", "destination": "/api/feed" },
    { "source": "/companion", "destination": "/mobile-web/companion/index.html" },
    { "source": "/companion/", "destination": "/mobile-web/companion/index.html" },
    { "source": "/(.*)", "destination": "/mobile-web/$1" }
  ]
}
