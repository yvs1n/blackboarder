{
  "version": 2,
  "public": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/feed.ics", "destination": "/api/feed" },
    { "source": "/cal.ics", "destination": "/api/feed" },
    { "source": "/(.*)", "destination": "/mobile-web/$1" }
  ]
}
